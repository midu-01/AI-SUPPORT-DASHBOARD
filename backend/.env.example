# Copy this file to .env in the same folder (backend/.env) and adjust the values.
# .env is gitignored — never commit real secrets.

# App
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database — local PostgreSQL.
# Replace "postgres:postgres" with your own PostgreSQL user and password.
# If your local PostgreSQL has no password (common with Homebrew), just use the
# username, e.g. postgresql+asyncpg://myuser@localhost:5432/ai_support
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_support
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_support_test

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File upload
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_DIR=uploads

# CORS — the Next.js dev server
ALLOWED_ORIGINS=["http://localhost:3000"]
